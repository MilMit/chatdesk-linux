{
  "name": "chatdesk-linux",
  "version": "0.6.1",
  "description": "Unofficial ChatGPT desktop client for Linux with stable long-response streaming, isolated profiles, native interactions, diagnostics, and Linux integration.",
  "type": "module",
  "main": "build/main/index.js",
  "author": {
    "name": "MilMit",
    "url": "https://github.com/MilMit"
  },
  "license": "MIT",
  "homepage": "https://github.com/MilMit/chatdesk-linux#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MilMit/chatdesk-linux.git"
  },
  "bugs": {
    "url": "https://github.com/MilMit/chatdesk-linux/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run bundle && electron .",
    "test": "node --test",
    "check": "node scripts/check-syntax.js",
    "dist": "npm run dist:linux",
    "dist:linux": "npm run bundle && electron-builder --linux AppImage deb && node scripts/enrich-deb.js",
    "dist:snap": "npm run bundle && electron-builder --linux snap",
    "test:ui": "npm run bundle && xvfb-run -a electron . --ui-smoke-test",
    "sbom": "npm sbom --sbom-format spdx > dist/chatdesk-linux-sbom.spdx.json",
    "dist:deb": "npm run bundle && electron-builder --linux deb && node scripts/enrich-deb.js",
    "bundle": "node scripts/bundle.js",
    "release:github": "bash scripts/publish-github.sh"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.5",
    "esbuild": "0.28.1"
  },
  "build": {
    "appId": "io.github.milmit.chatdesk",
    "productName": "ChatDesk Linux",
    "artifactName": "chatdesk-linux-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "build/**/*",
      "src/**/*.html",
      "src/**/*.css",
      "assets/**/*",
      "scripts/enrich-deb.js",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "executableName": "chatdesk-linux",
      "desktop": {
        "entry": {
          "Name": "ChatDesk Linux",
          "Comment": "Unofficial desktop wrapper for ChatGPT on Linux",
          "Categories": "Network;Utility;",
          "Keywords": "ChatGPT;OpenAI;AI;Assistant;Linux;Desktop;",
          "StartupWMClass": "io.github.milmit.chatdesk",
          "MimeType": "x-scheme-handler/chatdesk;text/plain;text/markdown;application/pdf;application/json;image/png;image/jpeg;image/webp;",
          "Icon": "io.github.milmit.chatdesk"
        },
        "desktopActions": {
          "NewChat": {
            "Name": "New Chat",
            "Exec": "chatdesk-linux --new-chat"
          },
          "QuickChat": {
            "Name": "Quick Chat",
            "Exec": "chatdesk-linux --quick-chat"
          },
          "Downloads": {
            "Name": "Open Downloads",
            "Exec": "chatdesk-linux --downloads"
          },
          "Settings": {
            "Name": "Open Settings",
            "Exec": "chatdesk-linux --settings"
          },
          "Diagnostics": {
            "Name": "Open Diagnostics",
            "Exec": "chatdesk-linux --diagnostics"
          },
          "SafeMode": {
            "Name": "Start in Safe Mode",
            "Exec": "chatdesk-linux --safe-mode"
          },
          "CommandPalette": {
            "Name": "Command Palette",
            "Exec": "chatdesk-linux --command-palette"
          },
          "QuickCapture": {
            "Name": "Quick Capture",
            "Exec": "chatdesk-linux --quick-chat"
          },
          "Prompts": {
            "Name": "Prompt Library",
            "Exec": "chatdesk-linux --prompts"
          },
          "Workspaces": {
            "Name": "Workspaces",
            "Exec": "chatdesk-linux --workspaces"
          },
          "Health": {
            "Name": "Installation Health",
            "Exec": "chatdesk-linux --health"
          }
        }
      },
      "syncDesktopName": true,
      "synopsis": "Unofficial ChatGPT desktop client for Linux",
      "description": "ChatDesk Linux provides stable long-response handling, isolated profiles, native interactions, prompt tools, diagnostics, and Linux desktop integration.",
      "maintainer": "MilMit <MilMit@users.noreply.github.com>",
      "vendor": "MilMit"
    },
    "snap": {
      "confinement": "strict",
      "grade": "stable",
      "plugs": [
        "desktop",
        "desktop-legacy",
        "home",
        "network",
        "opengl",
        "wayland",
        "x11",
        "audio-record",
        "camera"
      ]
    },
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "md",
          "log",
          "json",
          "pdf",
          "png",
          "jpg",
          "jpeg",
          "webp"
        ],
        "name": "ChatDesk Share File",
        "description": "Share a file with ChatDesk Linux",
        "role": "Viewer"
      }
    ],
    "deb": {
      "packageName": "chatdesk-linux",
      "packageCategory": "net",
      "priority": "optional",
      "maintainer": "MilMit <MilMit@users.noreply.github.com>",
      "vendor": "MilMit",
      "synopsis": "Unofficial ChatGPT desktop client for Linux",
      "description": "ChatDesk Linux provides stable long-response handling, isolated profiles, native interactions, prompt tools, diagnostics, and Linux desktop integration."
    }
  },
  "keywords": [
    "chatgpt",
    "openai",
    "linux",
    "desktop",
    "electron",
    "ai",
    "assistant",
    "unofficial"
  ],
  "desktopName": "io.github.milmit.chatdesk.desktop"
}
